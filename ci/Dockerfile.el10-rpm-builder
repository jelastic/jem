FROM almalinux:10@sha256:5a4b41a427c9717be8f4ac2a32aa22efbae5f9124fbcb79a6765394f312acfe8

RUN sed -ri \
        -e 's|^mirrorlist=|# mirrorlist=|' \
        -e 's|^# baseurl=https://repo.almalinux.org/|baseurl=https://repo.almalinux.org/|' \
        /etc/yum.repos.d/almalinux-*.repo \
    && dnf clean all \
    && dnf -y --refresh --setopt=retries=5 install rpm-build tar gzip findutils diffutils \
    && dnf clean all \
    && rm -rf /var/cache/dnf

WORKDIR /repo
ENTRYPOINT ["/bin/bash", "-lc"]
