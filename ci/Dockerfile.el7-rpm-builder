FROM centos:7@sha256:be65f488b7764ad3638f236b7b515b3678369a5124c47b8d32916d6487418ea4

COPY CentOS-7-Vault.repo /etc/yum.repos.d/CentOS-Base.repo

RUN find /etc/yum.repos.d -maxdepth 1 -type f ! -name 'CentOS-Base.repo' -delete \
    && yum clean all \
    && yum -y makecache --disablerepo='*' --enablerepo=centos-base,centos-updates,centos-extras \
    && yum -y install --disablerepo='*' --enablerepo=centos-base,centos-updates,centos-extras \
        rpm-build tar gzip findutils coreutils diffutils \
    && yum clean all \
    && rm -rf /var/cache/yum

WORKDIR /repo
ENTRYPOINT ["/bin/bash", "-lc"]
