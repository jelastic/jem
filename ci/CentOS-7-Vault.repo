# CentOS Linux 7 is EOL. Use immutable 7.9.2009 archives with fallbacks.
[centos-base]
name=CentOS-7.9.2009 - Base
baseurl=https://archive.kernel.org/centos-vault/7.9.2009/os/$basearch/ https://linuxsoft.cern.ch/centos-vault/7.9.2009/os/$basearch/ https://vault.centos.org/7.9.2009/os/$basearch/
failovermethod=priority
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
metadata_expire=never

[centos-updates]
name=CentOS-7.9.2009 - Updates
baseurl=https://archive.kernel.org/centos-vault/7.9.2009/updates/$basearch/ https://linuxsoft.cern.ch/centos-vault/7.9.2009/updates/$basearch/ https://vault.centos.org/7.9.2009/updates/$basearch/
failovermethod=priority
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
metadata_expire=never

[centos-extras]
name=CentOS-7.9.2009 - Extras
baseurl=https://archive.kernel.org/centos-vault/7.9.2009/extras/$basearch/ https://linuxsoft.cern.ch/centos-vault/7.9.2009/extras/$basearch/ https://vault.centos.org/7.9.2009/extras/$basearch/
failovermethod=priority
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7
metadata_expire=never
